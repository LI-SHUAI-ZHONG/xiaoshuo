# Copy to .env for local development and replace every replace-with-* value.
# These are non-production placeholders. Never commit .env or real credentials.

ACCOS_COMPOSE_PROJECT_NAME=accos

ACCOS_POSTGRES_DB=accos
ACCOS_POSTGRES_USER=accos
ACCOS_POSTGRES_PASSWORD=replace-with-local-postgres-password
ACCOS_POSTGRES_PORT=5432
ACCOS_DATABASE_URL=postgresql+psycopg://accos:replace-with-local-postgres-password@127.0.0.1:5432/accos

ACCOS_REDIS_PASSWORD=replace-with-local-redis-password
ACCOS_REDIS_PORT=6379
ACCOS_REDIS_URL=redis://:replace-with-local-redis-password@127.0.0.1:6379/0

ACCOS_S3_ENDPOINT=http://127.0.0.1:9000
ACCOS_S3_BUCKET=accos-dev
ACCOS_S3_ACCESS_KEY=replace-with-local-minio-access
ACCOS_S3_SECRET_KEY=replace-with-local-minio-secret
ACCOS_S3_REGION=us-east-1
ACCOS_S3_USE_SSL=false
ACCOS_MINIO_API_PORT=9000
ACCOS_MINIO_CONSOLE_PORT=9001

ACCOS_ENV=development
ACCOS_LOG_LEVEL=INFO
ACCOS_API_HOST=127.0.0.1
ACCOS_API_PORT=8000
ACCOS_HEALTH_TIMEOUT_SECONDS=2.0
ACCOS_DB_POOL_SIZE=5
ACCOS_DB_MAX_OVERFLOW=10
ACCOS_DB_POOL_TIMEOUT_SECONDS=30.0
ACCOS_DB_POOL_RECYCLE_SECONDS=1800
ACCOS_AI_PROVIDER=
ACCOS_REAL_PROVIDER_CALLS_ENABLED=false
# Stage 27: real is the default; test/demo are explicit non-production fixture modes.
ACCOS_MODEL_MODE=real
# Exact administrator-controlled base URLs; cloud profiles require HTTPS and vault credentials.
ACCOS_LOCAL_MODEL_ENDPOINTS=http://127.0.0.1:11434,http://localhost:11434

# Local metrics are always low-cardinality. OTLP is optional and fail-open.
ACCOS_METRICS_ENABLED=true
ACCOS_OTLP_ENDPOINT=
ACCOS_OTLP_TIMEOUT_SECONDS=1.0
ACCOS_OTLP_EXPORT_INTERVAL_SECONDS=5.0
ACCOS_OTLP_GRPC_PORT=4317
ACCOS_OTLP_HTTP_PORT=4318
ACCOS_JAEGER_PORT=16686
ACCOS_PROMETHEUS_PORT=9090
ACCOS_RUNTIME_HEARTBEAT_SECONDS=5.0
ACCOS_RUNTIME_HEARTBEAT_TTL_SECONDS=20

# Shared finite external-I/O and per-process API limits.
ACCOS_EXTERNAL_TIMEOUT_SECONDS=5.0
ACCOS_EXTERNAL_MAX_ATTEMPTS=3
ACCOS_EXTERNAL_BACKOFF_SECONDS=0.1
ACCOS_EXTERNAL_MAX_BACKOFF_SECONDS=2.0
ACCOS_EXTERNAL_CIRCUIT_FAILURE_THRESHOLD=5
ACCOS_EXTERNAL_CIRCUIT_COOLDOWN_SECONDS=30.0
ACCOS_EXTERNAL_CONCURRENCY_LIMIT=16
ACCOS_RATE_LIMIT_REQUESTS=120
ACCOS_RATE_LIMIT_WINDOW_SECONDS=60.0

# Deferred extension capabilities. Disabled values require no provider SDK, key, or service.
ACCOS_EXTENSION_MULTIMODAL_IMAGE_ENABLED=false
ACCOS_EXTENSION_MULTIMODAL_AUDIO_ENABLED=false
ACCOS_EXTENSION_MULTIMODAL_VIDEO_ENABLED=false
ACCOS_EXTENSION_MULTIMODAL_THREE_D_ENABLED=false
ACCOS_EXTENSION_GRAPH_ENABLED=false
ACCOS_EXTENSION_COLLABORATION_ENABLED=false
ACCOS_EXTENSION_RIGHTS_ENABLED=false
ACCOS_EXTENSION_MARKETPLACE_ENABLED=false
ACCOS_EXTENSION_REPUTATION_ENABLED=false
ACCOS_EXTENSION_GROWTH_ENABLED=false
ACCOS_EXTENSION_KNOWLEDGE_NETWORK_ENABLED=false

# Disabled by default. The primary token and IDs are required outside production; the approver
# token/actor pair is optional except for the Stage 23 human-approval smoke.
ACCOS_DEV_IDENTITY_ENABLED=false
ACCOS_DEV_IDENTITY_TOKEN=
ACCOS_DEV_IDENTITY_ACTOR_ID=
ACCOS_DEV_IDENTITY_WORKSPACE_ID=
ACCOS_DEV_IDENTITY_APPROVER_TOKEN=
ACCOS_DEV_IDENTITY_APPROVER_ACTOR_ID=

# Real local identity. Generate a private fragment with scripts/setup_identity.py (see runbook).
# The file is read locally; process variables override it. Never commit its contents.
ACCOS_IDENTITY_CONFIG_FILE=
ACCOS_PUBLIC_ORIGIN=http://localhost:3000
ACCOS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ACCOS_SESSION_HOURS=12
ACCOS_BOOTSTRAP_TOKEN_SHA256=
# Only set when choosing between multiple existing development workspaces.
ACCOS_BOOTSTRAP_ADOPT_WORKSPACE_ID=
ACCOS_SECRET_KEYS_JSON={}
ACCOS_SECRET_ACTIVE_KEY_ID=

# Optional team OIDC: pre-provision the issuer/subject in Settings. Local login remains available.
ACCOS_OIDC_ISSUER=
ACCOS_OIDC_CLIENT_ID=
ACCOS_OIDC_CLIENT_SECRET=
ACCOS_OIDC_AUTHORIZATION_ENDPOINT=
ACCOS_OIDC_TOKEN_ENDPOINT=
ACCOS_OIDC_JWKS_URI=

# Studio forwards /api/v1 through the same browser origin (set for its process as well).
ACCOS_API_ORIGIN=http://127.0.0.1:8000
