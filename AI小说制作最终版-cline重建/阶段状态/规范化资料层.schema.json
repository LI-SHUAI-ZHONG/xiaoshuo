{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "诡异屋最小可执行资料层",
  "type": "object",
  "required": ["schema_version", "status", "records", "indexes", "gates"],
  "properties": {
    "schema_version": {"const": "normalized-content-layer-1.0"},
    "status": {"enum": ["partial_blocked", "ready_for_review"]},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "domain", "evidence_level", "claim", "source_refs", "runtime_usable", "use"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
          "domain": {"type": "string"},
          "evidence_level": {"enum": ["confirmed_raw", "cross_confirmed", "reconstructed", "unconfirmed", "conflict"]},
          "claim": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "runtime_usable": {"type": "boolean"},
          "use": {"enum": ["fact", "constraint", "candidate", "gap", "blocker"]},
          "validation": {"type": "object"}
        }
      }
    },
    "indexes": {"type": "object"},
    "gates": {"type": "object"}
  }
}